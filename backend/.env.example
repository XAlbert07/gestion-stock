PORT=3000
TRUST_PROXY_HOPS=0
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_stock
DB_USER=gestion_stock_user
DB_PASSWORD=change_me
# Connexion chiffrée : true est obligatoire chez Neon, Supabase, etc.
DB_SSL=false
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
ADMIN_FIRST_NAME=Administrateur
ADMIN_LAST_NAME=Local
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# Mode démonstration (bouton « Explorer la démo », compte en lecture seule)
DEMO_LOGIN_ENABLED=false
# DEMO_USER_EMAIL=demo@gestion-stock.local
# Charge la boutique de démonstration au démarrage si la base est vide (npm run start:render)
SEED_DEMO=false

