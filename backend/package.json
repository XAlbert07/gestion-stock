{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:render": "npm run db:migrate && (npm run bootstrap:admin -- --if-configured || true) && (npm run bootstrap:demo || true) && (npm run db:seed:demo -- --if-empty || true) && npm start",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "format": "prettier --write \"{src,tests,scripts}/**/*.js\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.js\"",
    "check": "npm run lint && npm run format:check && npm test",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:seed:demo": "node scripts/seed-demo.js",
    "bootstrap:admin": "node scripts/bootstrap-admin.js",
    "bootstrap:demo": "node scripts/bootstrap-demo-user.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
